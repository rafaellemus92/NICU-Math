import Wyrd.Minimal
/-!
Writes `Wyrd/MinimalTable{0,1,2,3}.lean`: the candidate list for every even sum
1352 … 4294, eight sums per theorem (to bound the kernel's memory), in four files
(so `lake build` checks them in parallel). Nothing here is trusted: each
theorem has the kernel recompute `cands N` and compare.

Usage, from `experiments/wyrd`: `lake env lean scripts/GenTables.lean`
-/
open Wyrd

def sums : List Nat := (List.range 1472).map fun i => 1352 + 2 * i

partial def chunk (l : List α) (n : Nat) : List (List α) :=
  if l.length ≤ n then [l] else l.take n :: chunk (l.drop n) n

def main : IO Unit := do
  let groups := chunk sums 8
  let files := chunk groups 46
  for (fileGroups, fi) in files.zipIdx do
    let mut out := s!"import Wyrd.Minimal\n\n/-! Generated by `scripts/GenTables.lean`; do not edit by hand.\nCandidate lists for even sums {fileGroups.head!.head!} … {fileGroups.getLast!.getLast!}. -/\n\nset_option maxRecDepth 100000\n\nnamespace Wyrd\n"
    let mut names : Array String := #[]
    for (g, gi) in fileGroups.zipIdx do
      let nm := s!"t{fi}_{gi}"
      names := names.push nm
      let rows := g.map fun N => s!"  ({N}, {cands N})"
      out := out ++ s!"\ndef {nm} : List (Nat × List Nat) := [\n{",\n".intercalate rows}]\n"
      out := out ++ s!"theorem {nm}_ok : {nm}.all checkEntry = true := by decide +kernel\n"
    out := out ++ s!"\ndef table{fi} : List (Nat × List Nat) :=\n  {" ++ ".intercalate names.toList}\n"
    out := out ++ s!"\ntheorem table{fi}_ok : table{fi}.all checkEntry = true := by\n  simp only [table{fi}, List.all_append, {", ".intercalate (names.toList.map (· ++ "_ok"))}, Bool.and_self]\n"
    out := out ++ "\nend Wyrd\n"
    IO.FS.writeFile s!"Wyrd/MinimalTable{fi}.lean" out
    IO.println s!"wrote Wyrd/MinimalTable{fi}.lean ({fileGroups.length} groups)"

#eval main
