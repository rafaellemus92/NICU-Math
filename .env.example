# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# Local dev defaults match docker-compose.yml. For a hosted deployment,
# point DATABASE_URL at your managed Postgres (with pgvector enabled).

# ─── Postgres ───────────────────────────────────────────────────────────
POSTGRES_USER=nicu
POSTGRES_PASSWORD=nicu
POSTGRES_DB=nicu

# For the api service running outside Docker, override to localhost:
#   DATABASE_URL=postgresql://nicu:nicu@localhost:5432/nicu
# Inside the docker-compose network, use the service name `db`:
DATABASE_URL=postgresql://nicu:nicu@db:5432/nicu

# ─── OpenAI (embeddings for hybrid retrieval) ──────────────────────────
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# ─── Streamlit UI ──────────────────────────────────────────────────────
STREAMLIT_PORT=8501
# From a browser on the host, API_URL is http://localhost:8000.
# Inside docker-compose the ui container reaches the api by service name:
API_URL=http://api:8000

# ─── Library path (static PDFs served under /files) ────────────────────
# Leave unset to let the api auto-discover ./library next to the working dir.
# LIBRARY_DIR=/app/library
