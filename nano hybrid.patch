+def _get_or_make_query_vec(con, q: str) -> list[float]:
+    """Tiny embedding cache in Postgres to shave 100–300ms on repeats."""
+    with con.cursor() as cur:
+        cur.execute("SELECT v FROM query_cache WHERE q=%s", (q,))
+        row = cur.fetchone()
+        if row:
+            # row[0] is a pgvector; cast to python list
+            return list(row[0])
+    v = _embed(q)
+    with con.cursor() as cur:
+        cur.execute(
+            "INSERT INTO query_cache(q, v) VALUES (%s, %s) ON CONFLICT (q) DO UPDATE SET v=EXCLUDED.v, ts=now()",
+            (q, _pgvector_literal(v)),
+        )
+    return v
+
+def _semantic_topk(con, v_lit: str, k: int) -> List[Dict[str, Any]]:
+    sql = """
+        SELECT d.id, d.title, d.source_path, c.chunk_index, c.content,
+               (c.embedding <-> %(v)s::vector) AS score
+        FROM chunks c
+        JOIN documents d ON d.id = c.document_id
+        ORDER BY c.embedding <-> %(v)s::vector
+        LIMIT %(k)s;
+    """
+    out = []
+    with con.cursor() as cur:
+        cur.execute(sql, {"v": v_lit, "k": k})
+        for r in cur.fetchall():
+            out.append(
+                dict(
+                    document_id=r[0],
+                    title=r[1],
+                    path=r[2],
+                    chunk_index=r[3],
+                    content=r[4],
+                    score=float(r[5]),
+                )
+            )
+    return out
+
+def _lexical_topk(con, q: str, k: int) -> List[Dict[str, Any]]:
+    sql = """
+        SELECT d.id, d.title, d.source_path, c.chunk_index, c.content,
+               ts_rank_cd(c.tsv, plainto_tsquery('english', %(q)s)) AS score
+        FROM chunks c
+        JOIN documents d ON d.id = c.document_id
+        WHERE c.tsv @@ plainto_tsquery('english', %(q)s)
+        ORDER BY score DESC
+        LIMIT %(k)s;
+    """
+    out = []
+    with con.cursor() as cur:
+        cur.execute(sql, {"q": q, "k": k})
+        for r in cur.fetchall():
+            out.append(
+                dict(
+                    document_id=r[0],
+                    title=r[1],
+                    path=r[2],
+                    chunk_index=r[3],
+                    content=r[4],
+                    score=float(r[5]),
+                )
+            )
+    return out
+
+def _rrf_merge(sem_rows: List[Dict[str, Any]],
+               lex_rows: List[Dict[str, Any]],
+               k: int,
+               k_rrf: int = 60) -> List[Dict[str, Any]]:
+    """
+    Reciprocal Rank Fusion:
+      score = Σ 1 / (k_rrf + rank_i)
+    Merge by (document_id, chunk_index) identity.
+    """
+    def as_key(r: Dict[str, Any]) -> Tuple[int, int]:
+        return (r["document_id"], r["chunk_index"])
+
+    scores: Dict[Tuple[int, int], float] = {}
+    index: Dict[Tuple[int, int], Dict[str, Any]] = {}
+    for i, r in enumerate(sem_rows):
+        k_ = as_key(r)
+        scores[k_] = scores.get(k_, 0.0) + 1.0 / (k_rrf + i + 1)
+        index[k_] = r
+    for i, r in enumerate(lex_rows):
+        k_ = as_key(r)
+        scores[k_] = scores.get(k_, 0.0) + 1.0 / (k_rrf + i + 1)
+        index[k_] = index.get(k_, r)  # keep any copy
+
+    merged = []
+    for k_, s in scores.items():
+        r = dict(index[k_])
+        r["score"] = s
+        merged.append(r)
+    merged.sort(key=lambda x: x["score"], reverse=True)
+    return merged[:k]

