+-- ---------- Full‑text search (hybrid) ----------
+-- tsvector column + GIN index + trigger to maintain it
+ALTER TABLE chunks ADD COLUMN IF NOT EXISTS tsv tsvector;
+CREATE INDEX IF NOT EXISTS idx_chunks_tsv ON chunks USING GIN(tsv);
+
+-- Create the trigger only if it does not exist
+DO $$
+BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'chunks_tsv_update') THEN
+    CREATE TRIGGER chunks_tsv_update
+    BEFORE INSERT OR UPDATE ON chunks
+    FOR EACH ROW EXECUTE FUNCTION tsvector_update_trigger('tsv','pg_catalog.english','content');
+  END IF;
+END$$;
+
+-- Backfill existing rows once
+UPDATE chunks SET tsv = to_tsvector('english', content) WHERE tsv IS NULL;
+
+-- ---------- Query embedding cache ----------
+CREATE TABLE IF NOT EXISTS query_cache (
+  q   TEXT PRIMARY KEY,
+  v   VECTOR(1536),
+  ts  TIMESTAMPTZ DEFAULT now()
+);
